{
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build --config web/vite.config.ts",
    "test": "vitest run",
    "usage": "tsx src/cli.ts usage",
    "usage:json": "tsx src/cli.ts usage --json",
    "login": "tsx src/cli.ts login",
    "server": "tsx src/server.ts",
    "web": "vite --host 127.0.0.1 --config web/vite.config.ts",
    "dev": "concurrently -n api,web -c auto \"npm:server\" \"npm:web\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@vitejs/plugin-react": "^5.0.0",
    "better-sqlite3": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^14.0.3",
    "concurrently": "^9.2.1",
    "date-fns": "^4.2.1",
    "express": "^5.1.0",
    "ink": "^7.0.3",
    "lucide-react": "^0.511.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.20.5",
    "tw-animate-css": "^1.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "shadcn": "^4.8.0",
    "vitest": "^4.1.7"
  }
}
